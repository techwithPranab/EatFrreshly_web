# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Google Analytics Measurement Protocol (Server-side)
# Get these from your GA4 property settings (Measurement Protocol API secret)
GA_MEASUREMENT_ID=G-XXXXXXXXXX
GA_API_SECRET=your_measurement_protocol_api_secret

# Email Configuration (Brevo/Sendinblue SMTP)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USERNAME=your_brevo_username_here
BREVO_SMTP_PASSWORD=your_brevo_password_here
EMAIL_SENDER_NAME=Healthy Restaurant
EMAIL_SENDER_EMAIL=noreply@healthyrestaurant.com

# Frontend URL for unsubscribe links
FRONTEND_URL=http://localhost:3001

# MongoDB Connection (existing)
MONGODB_URI=mongodb://localhost:27017/healthy-restaurant

# JWT Secret (existing)
JWT_SECRET=your_jwt_secret

# Other existing configurations...
NODE_ENV=development
PORT=5000
